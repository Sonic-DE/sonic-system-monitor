# All test-facing paths live below this build directory. Imported SDK locations
# are used only to prepare links, never embedded as distribution paths in tests.
set(_runtime "${CMAKE_CURRENT_LIST_DIR}/applications-runtime/$<CONFIG>")

function(_link_runtime_directory source destination optional)
    if(NOT IS_DIRECTORY "${source}")
        if(NOT optional)
            message(FATAL_ERROR "Missing staged test input: ${source}")
        endif()
        set(source "${_runtime}/empty")
        file(MAKE_DIRECTORY "${source}")
    endif()
    get_filename_component(source "${source}" REALPATH)
    if(IS_SYMLINK "${destination}")
        file(READ_SYMLINK "${destination}" previous)
        if(previous STREQUAL source)
            return()
        endif()
        file(REMOVE "${destination}")
    elseif(EXISTS "${destination}")
        message(FATAL_ERROR "Refusing to replace a non-link test runtime path: ${destination}")
    endif()
    file(CREATE_LINK "${source}" "${destination}" SYMBOLIC RESULT result)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Cannot prepare test runtime: ${result}")
    endif()
endfunction()

function(_prepare_runtime)
    file(MAKE_DIRECTORY "${_runtime}/sdk" "${_runtime}/frameworks" "${_runtime}/tmp")
    file(LOCK "${_runtime}/.prepare.lock" GUARD FUNCTION TIMEOUT 30)
    _link_runtime_directory("@_application_sdk_qml@" "${_runtime}/sdk/qml" FALSE)
    _link_runtime_directory("@_application_framework_qml@" "${_runtime}/frameworks/qml" FALSE)
    _link_runtime_directory("@_application_sdk_plugins@" "${_runtime}/sdk/plugins" TRUE)
    _link_runtime_directory("@_application_framework_plugins@" "${_runtime}/frameworks/plugins" TRUE)
    _link_runtime_directory("@_application_sdk_data@" "${_runtime}/sdk/share" TRUE)
    _link_runtime_directory("@_application_framework_data@" "${_runtime}/frameworks/share" TRUE)
    # Abstract sockets avoid Unix socket pathname limits in long build paths.
    string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef bus_suffix)
    set(APPLICATION_TEST_BUS_ADDRESS "unix:abstract=sonic-monitor-test-${bus_suffix}")
    set(work "${_runtime}/runs/${bus_suffix}")
    file(MAKE_DIRECTORY "${work}/home" "${work}/data" "${work}/config" "${work}/cache" "${work}/tmp")
    set(bus_config "${work}/dbus.conf")
    configure_file("${CMAKE_CURRENT_LIST_DIR}/applications_test_dbus.conf" "${bus_config}" @ONLY)
    set(APPLICATION_TEST_DBUS_CONFIG "${bus_config}" PARENT_SCOPE)
    set(APPLICATION_TEST_WORKDIR "${work}" PARENT_SCOPE)
endfunction()

_prepare_runtime()
set(ENV{QT_QPA_PLATFORM} "${APPLICATION_TEST_PLATFORM}")
set(ENV{QT_QUICK_BACKEND} "software")
set(ENV{TMPDIR} "${APPLICATION_TEST_WORKDIR}/tmp")
set(ENV{HOME} "${APPLICATION_TEST_WORKDIR}/home")
set(ENV{XDG_DATA_HOME} "${APPLICATION_TEST_WORKDIR}/data")
set(ENV{XDG_CONFIG_HOME} "${APPLICATION_TEST_WORKDIR}/config")
set(ENV{XDG_CACHE_HOME} "${APPLICATION_TEST_WORKDIR}/cache")
set(ENV{QT_PLUGIN_PATH} "${_runtime}/sdk/plugins:${_runtime}/frameworks/plugins")
set(ENV{QML_IMPORT_PATH} "${CMAKE_CURRENT_LIST_DIR}/../bin:${_runtime}/sdk/qml:${_runtime}/frameworks/qml")
set(ENV{XDG_DATA_DIRS} "${CMAKE_CURRENT_LIST_DIR}/applications-ui-data:${_runtime}/sdk/share:${_runtime}/frameworks/share")

if(APPLICATION_TEST_USE_DBUS)
    set(prefix "@DBUS_RUN_SESSION_EXECUTABLE@" "--config-file=${APPLICATION_TEST_DBUS_CONFIG}" --)
endif()
execute_process(COMMAND ${prefix} "${APPLICATION_TEST_EXECUTABLE}"
    WORKING_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}" RESULT_VARIABLE result)
file(REMOVE "${APPLICATION_TEST_DBUS_CONFIG}")
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Application test failed: ${result}")
endif()
